{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "UsageChecker": {
    "IsEnabled": true,
    "ReportPeriodicity": 60,
    "CheckPeriodicity": 10,
    "CpuThreshold": 80,
    "RamThreshold": 80,
    "PageThreshold": 80,
    "ThresholdHits": 1
  },
  "ProcessesAvailability": {
    "IsEnabled": true,
    "CheckPeriodicity": 10,
    "Processes": [
      {
        "ProcessName": "w3wp",
        "ProcessDisplayName": "IIS Worker Process"
      },
      {
        "ProcessName": "sqlservr",
        "ProcessDisplayName": "SQL Server"
      }
    ]
  },
  "IISMonitoring": {
    "CpuThreshold": 80,
    "LogLocationForAppPools": [
        {
          "AppPoolName": "godoc.local",
          "LogLocation": "C:\\opt"
        }
    ]
  },
  "EmailSettings": {
    "BaseUri": "https://api.eu.mailgun.net/v3",
    "NotificationEnabled": true,
    "NotificationEmails": "comma separated emails",
    "Subject": "Prod1 - Usage Checker Notification",
    "Domain": "",
    "SenderAddress": "",
    "SenderDisplayName": "",
    "MainGunApiKey": ""
  }
}
